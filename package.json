{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@mui/x-internals": "9.9.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-ocr-assets.mjs",
    "ocr:prepare": "node scripts/prepare-ocr-assets.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:database": "node tests/database-workflows.mjs",
    "test:ui": "playwright test",
    "test:guest": "playwright test --config playwright.guest.config.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "admin:create": "ts-node --project tsconfig.scripts.json scripts/create-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:introspect": "prisma db pull",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup-database.mjs",
    "db:seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.9.0",
    "@prisma/client": "5.22.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}

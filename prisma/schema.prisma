generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(150)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(30)
  address    String?
  status     String   @default("ACTIVE") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  orders     orders[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_movements {
  id             BigInt   @id @default(autoincrement())
  product_id     BigInt
  type           String   @db.VarChar(30)
  quantity       Int
  reference_type String?  @db.VarChar(30)
  reference_id   BigInt?
  created_by     BigInt
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  products       products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_product")
  users          users    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_user")

  @@index([product_id], map: "idx_inventory_product")
  @@index([reference_type, reference_id], map: "idx_inventory_reference")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ledger_entries {
  id               BigInt   @id @default(autoincrement())
  transaction_date DateTime @default(now()) @db.Timestamptz(6)
  account_name     String   @db.VarChar(100)
  entry_type       String   @db.VarChar(10)
  amount           Decimal  @db.Decimal(12, 2)
  reference_type   String?  @db.VarChar(30)
  reference_id     BigInt?
  description      String?
  created_by       BigInt
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ledger_user")

  @@index([transaction_date], map: "idx_ledger_date")
  @@index([reference_type, reference_id], map: "idx_ledger_reference")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id         BigInt   @id @default(autoincrement())
  order_id   BigInt
  product_id BigInt
  quantity   Int
  unit_price Decimal  @db.Decimal(12, 2)
  line_total Decimal  @db.Decimal(12, 2)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_item_order")
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_item_product")

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id           BigInt        @id @default(autoincrement())
  customer_id  BigInt
  created_by   BigInt
  order_date   DateTime      @default(now()) @db.Timestamptz(6)
  status       String        @default("PENDING") @db.VarChar(30)
  subtotal     Decimal       @default(0) @db.Decimal(12, 2)
  tax          Decimal       @default(0) @db.Decimal(12, 2)
  total_amount Decimal       @default(0) @db.Decimal(12, 2)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)
  order_items  order_items[]
  customers    customers     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_customer")
  users        users         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_user")

  @@index([created_by], map: "idx_orders_created_by")
  @@index([customer_id], map: "idx_orders_customer")
  @@index([order_date], map: "idx_orders_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                  BigInt                @id @default(autoincrement())
  sku                 String                @unique @db.VarChar(50)
  name                String                @db.VarChar(150)
  size                String?               @db.VarChar(50)
  stock_qty           Int                   @default(0)
  unit_cost           Decimal               @default(0) @db.Decimal(12, 2)
  selling_price       Decimal               @db.Decimal(12, 2)
  status              String                @default("ACTIVE") @db.VarChar(20)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  order_items         order_items[]
  purchase_items      purchase_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_items {
  id                BigInt          @id @default(autoincrement())
  purchase_order_id BigInt
  product_id        BigInt
  quantity          Int
  unit_price        Decimal         @db.Decimal(12, 2)
  line_total        Decimal         @db.Decimal(12, 2)
  purchase_orders   purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_purchase_item_order")
  products          products        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_item_product")

  @@index([purchase_order_id], map: "idx_purchase_items_order")
  @@index([product_id], map: "idx_purchase_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_orders {
  id             BigInt           @id @default(autoincrement())
  supplier_id    BigInt
  created_by     BigInt
  purchase_date  DateTime         @default(now()) @db.Timestamptz(6)
  status         String           @default("PENDING") @db.VarChar(30)
  total_amount   Decimal          @default(0) @db.Decimal(12, 2)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  purchase_items purchase_items[]
  suppliers      suppliers        @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_supplier")
  users          users            @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchase_user")

  @@index([supplier_id], map: "idx_purchase_orders_supplier")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model suppliers {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(150)
  contact_person  String?           @db.VarChar(150)
  email           String?           @db.VarChar(255)
  phone           String?           @db.VarChar(30)
  address         String?
  status          String            @default("ACTIVE") @db.VarChar(20)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  purchase_orders purchase_orders[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_sessions       user_sessions[]
  id                  BigInt                @id @default(autoincrement())
  name                String                @db.VarChar(100)
  email               String                @unique @db.VarChar(255)
  password_hash       String
  role                String                @db.VarChar(30)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  ledger_entries      ledger_entries[]
  orders              orders[]
  purchase_orders     purchase_orders[]
}

model user_sessions {
  token_hash           String   @id @db.VarChar(64)
  user_id              BigInt
  password_fingerprint String   @db.VarChar(64)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  expires_at           DateTime @db.Timestamptz(6)
  users                users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([expires_at])
}

model api_rate_limits {
  key        String   @id @db.VarChar(64)
  count      Int
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at])
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  actor_id    BigInt?
  actor_name  String   @db.VarChar(100)
  actor_role  String?  @db.VarChar(30)
  action      String   @db.VarChar(60)
  entity_type String   @db.VarChar(30)
  entity_id   BigInt?
  outcome     String   @db.VarChar(20)
  before      Json?
  after       Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at, id])
  @@index([actor_id, created_at])
  @@index([entity_type, entity_id])
  @@index([action, created_at])
}

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/erp_lite?schema=public"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Local export source only. Production serves the bundled guest snapshot.
# URL-encode special characters in the password. Never point this at private records.
GUEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/erp_lite?schema=public"

# Set only to a single-IP header your reverse proxy overwrites (e.g. x-real-ip).
# Without it, requests share a conservative application-wide rate limit.
TRUSTED_CLIENT_IP_HEADER=""
